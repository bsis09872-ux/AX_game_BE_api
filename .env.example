# 이 파일을 .env.local로 복사한 뒤 개인 DB 연결 정보와 JWT 비밀키를 입력하세요.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/ax_game

JWT_SECRET_KEY=
JWT_TTL_SECONDS=1800
REFRESH_TTL_SECONDS=1800
WEB_ORIGIN=http://127.0.0.1:8000

# 미설정 시 WEB_ORIGIN만 허용. 여러 Origin은 쉼표로 구분하며 *는 허용하지 않는다.
# CORS 허용 목록은 쿠키 쓰기 요청의 기존 WEB_ORIGIN 검사와 별개다.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,https://frontend.example.com

# 관리자 업로드 이미지 저장소. 배포 시 영속 볼륨 경로를 지정한다.
ITEM_IMAGE_DIR=.local/item-images
